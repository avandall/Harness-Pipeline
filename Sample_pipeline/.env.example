# Harness Engineering Playbook — environment template.
# Copy to .env and fill in real values. `.env` is gitignored. NEVER commit real secrets.
#
# Harness-engineering rule behind this file: the agent must never need to *guess* a store, a
# theme id, or a token. Every concrete value lives here, every script reads it through
# scripts/env.mjs (or `set -a; . ./.env; set +a` in shell), and the docs only ever mention
# the placeholder names.

# --- Store identity ---------------------------------------------------------------------
SHOPIFY_STORE="your-store.myshopify.com"     # the *.myshopify.com domain the CLI and Admin API use
SHOPIFY_PRIMARY_DOMAIN="www.your-brand.com"  # public primary domain (may differ; storefront redirects to it)
STOREFRONT_PASSWORD=""                       # storefront password if the store is password-protected
                                             # (dev/test stores usually are — the harness submits it on /password)

# --- Theme target (THE most important guardrail in this file) ---------------------------
SHOPIFY_THEME_ID=""                          # target theme id — MUST be an UNPUBLISHED theme.
                                             # `shopify theme list --store $SHOPIFY_STORE` shows roles.
                                             # No unpublished theme yet? create one:
                                             #   shopify theme push --unpublished --theme harness-dev --path theme
                                             # NEVER the [live] theme. Publishing is a separate, explicit step.
SHOPIFY_THEME_NAME="harness-dev"             # human label for the target theme

# --- Admin API (page/blog/menu/redirect records, theme publish) -------------------------
# Since 2026 new apps are created in the Shopify Dev Dashboard; they no longer show a permanent
# token. The harness mints a short-lived (24h) Admin API token itself from the app's client
# credentials (scripts/shopify-admin-token.mjs) and caches it in .ralph/ (gitignored).
SHOPIFY_CLIENT_ID=""                         # app client id   (Dev Dashboard → your app → Settings)
SHOPIFY_CLIENT_SECRET=""                     # app client secret — sensitive, never on screen/commit
SHOPIFY_ADMIN_TOKEN=""                       # optional: a legacy static token (shpat_…) from an app created
                                             # before 2026 — if set, it is used as-is and no minting happens
SHOPIFY_API_VERSION="2026-07"                # Admin API version (quarterly; keep in step with the docs you read)

# --- Source control ---------------------------------------------------------------------
GH_REPO="github.com/<owner>/<repo>"          # repo holding the theme + this harness

# --- Local validation browser (isolated Chrome for CDP; admin-only fallback tasks) -------
CDP_PORT="9333"
CDP_PROFILE="/tmp/harness-validate-profile"

# --- Local reference build (1:1 migration from a provided HTML/CSS/JS export, e.g. a design tool export)
# Drop the build at REF_ROOT/<name>/ and set the contract's source to the __REF__ placeholder,
# e.g. "source": "__REF__/<name>/index.html". scripts/visual-diff/serve-reference.mjs serves REF_ROOT
# on REF_PORT and the capture/gate scripts auto-resolve __REF__ to it — nothing downstream changes.
REF_PORT="9540"
REF_ROOT="reference"

# --- Agent provider (the harness is provider-neutral) -----------------------------------
# AGENT_PROVIDER="claude"                    # claude | codex | custom   (scripts/agent-runner.sh)
# AGENT_BIN=""                               # override the CLI binary
# AGENT_FLAGS=""                             # override the CLI flags (space-separated)
# AGENT_UNATTENDED=0                         # 1 = skip permission prompts — ONLY inside a sandbox/VM
