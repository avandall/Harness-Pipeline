#!/usr/bin/env python3
"""CLI Entrypoint wrapper for Enterprise Agent Pipeline Harness."""

import argparse
import os
import sys
from pathlib import Path

# Add project root and pipeline dir to sys.path
SCRIPT_DIR = Path(__file__).resolve().parent
PIPELINE_DIR = SCRIPT_DIR.parent
PROJECT_ROOT = PIPELINE_DIR.parent

for p in [str(PROJECT_ROOT), str(PIPELINE_DIR)]:
    if p not in sys.path:
        sys.path.insert(0, p)

try:
    from pipeline.engine.harness.loop import RalphLoopRunner
    from pipeline.engine.harness.state_machine import PipelineState
except ImportError:
    from engine.harness.loop import RalphLoopRunner
    from engine.harness.state_machine import PipelineState

import re

def get_next_todo_task(workspace_dir: Path) -> str:
    """Scan pipeline/docs/context/Tasks_list.md and return the first task marked [ ] TODO or [/] IN_PROGRESS."""
    tasks_file = workspace_dir / "pipeline" / "docs" / "context" / "Tasks_list.md"
    if not tasks_file.exists():
        tasks_file = workspace_dir / "pipeline/docs" / "context" / "Tasks_list.md"
    if not tasks_file.exists():
        return "TASK-001"

    content = tasks_file.read_text(encoding="utf-8")
    for line in content.splitlines():
        if "[ ] TODO" in line or "[/] IN_PROGRESS" in line:
            match = re.search(r"TASK-\d+", line)
            if match:
                return match.group(0)
    return "TASK-001"


def main():
    parser = argparse.ArgumentParser(description="Enterprise Agent Pipeline Execution Runner")
    parser.add_argument("--task", type=str, default="AUTO", help="Task ID to execute (default: AUTO picks first TODO task from Tasks_list.md)")
    parser.add_argument("--resume", action="store_true", help="Resume from last durable session log")
    parser.add_argument("--action", type=str, default="ORIENT", help="Initial action step")

    args = parser.parse_args()

    task_id = args.task
    if task_id.upper() == "AUTO":
        task_id = get_next_todo_task(PROJECT_ROOT)
        print(f"📋 Auto-detected next active task: [{task_id}] from Tasks_list.md")

    print(f"🚀 Initializing Enterprise Agent Pipeline for [{task_id}]...")
    runner = RalphLoopRunner(task_id=task_id, workspace_dir=PROJECT_ROOT)

    if args.resume:
        last_event = runner.event_log.get_last_event()
        if last_event:
            print(f"🔄 Resuming session at step {last_event.step} (Last event: {last_event.event_type.value})")
        else:
            print("⚠️ No previous session log found to resume. Starting fresh session.")

    runner.state_machine.transition_to(PipelineState.PLANNING)
    res = runner.run_iteration(action_type=args.action, command=f"Initialized task {task_id}")

    print(f"✅ Pipeline step executed successfully (State: {runner.state_machine.current_state.value}).")
    print(f"📊 Events logged to: {runner.log_file}")


if __name__ == "__main__":
    main()

